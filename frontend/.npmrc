; Direct connection to the npm registry.
;
; Both corporate proxies were unreachable from this network
; (172.25.20.117:80 and 172.16.10.80:8080 both fail a TCP connect), while a
; direct request to https://registry.npmjs.org returns HTTP 200. Empty values
; override the HTTP_PROXY / HTTPS_PROXY environment variables npm otherwise
; picks up.
;
; If you go back on the corporate network/VPN and direct access is blocked,
; restore the proxy lines instead of emptying them.
proxy=
https-proxy=

; strict-ssl stays ON. It was only needed to tolerate the proxy's
; TLS interception; going direct there is nothing to intercept.
strict-ssl=true
